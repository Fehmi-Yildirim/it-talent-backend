NODE_ENV=development
PORT=3000

# Generate a unique local secret:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-your-own-random-secret

# Local PostgreSQL database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/it_talent"

# Must match the frontend browser origin
CORS_ORIGIN="http://localhost:5173"

# Local file storage
CV_UPLOAD_DIR="uploads"

# Optional: path to LibreOffice executable
LIBREOFFICE_BIN="C:/Program Files/LibreOffice/program/soffice.exe"

# Bootstrap admin account — choose your own credentials
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=replace-with-a-strong-unique-password

# E2E test accounts — use credentials matching your test setup
E2E_CANDIDATE_EMAIL=candidate@example.com
E2E_CANDIDATE_PASSWORD=replace-with-a-test-password
E2E_RECRUITER_EMAIL=recruiter@example.com
E2E_RECRUITER_PASSWORD=replace-with-another-test-password