```dotenv
# Local development defaults. Configure production values in your deployment environment.
NODE_ENV=development
PORT=3000

# Required: generate a unique secret with at least 32 bytes for production.
# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Replace this placeholder before starting the application.
JWT_SECRET=replace-with-your-own-random-secret

# Required: PostgreSQL connection string.
# Use production database credentials from your deployment secret store in production.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/it_talent"

# Required in production. Comma-separated HTTP(S) origins are supported.
# Do not use localhost origins in production.
CORS_ORIGIN="http://localhost:5173"

# Local file storage
CV_UPLOAD_DIR="uploads"

# Maximum CV upload size in bytes (default: 10 MiB)
CV_MAX_FILE_SIZE_BYTES=10485760

# Optional: path to LibreOffice executable
LIBREOFFICE_BIN="C:/Program Files/LibreOffice/program/soffice.exe"

# Development/test bootstrap account only. Use unique credentials.
# Do not use these placeholder values in production.
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=replace-with-a-strong-unique-password

# E2E test accounts only. Do not use production user credentials.
E2E_CANDIDATE_EMAIL=candidate@example.com
E2E_CANDIDATE_PASSWORD=replace-with-a-test-password
E2E_RECRUITER_EMAIL=recruiter@example.com
E2E_RECRUITER_PASSWORD=replace-with-another-test-password
```